{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil bisnis UMKM dan pengaturan akun pengguna",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "ID pengguna Firebase Auth"
        },
        "businessName": {
          "type": "string",
          "maxLength": 100,
          "description": "Nama unit usaha atau UMKM"
        },
        "ownerName": {
          "type": "string",
          "maxLength": 100,
          "description": "Nama lengkap pemilik usaha"
        },
        "businessPhone": {
          "type": "string",
          "maxLength": 30,
          "description": "Nomor WhatsApp atau kontak usaha"
        },
        "businessAddress": {
          "type": "string",
          "maxLength": 250,
          "description": "Alamat lokasi usaha"
        },
        "monthlyProfitTarget": {
          "type": "number",
          "description": "Target laba bulanan dalam Rupiah"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50,
          "description": "Waktu pembaruan profil"
        }
      },
      "required": [
        "userId",
        "businessName"
      ]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Catatan transaksi pemasukan atau pengeluaran kas UMKM",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "ID unik transaksi"
        },
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "ID pemilik transaksi"
        },
        "type": {
          "type": "string",
          "enum": [
            "income",
            "expense"
          ],
          "description": "Tipe transaksi: income (pemasukan) atau expense (pengeluaran)"
        },
        "amount": {
          "type": "number",
          "description": "Nominal transaksi dalam Rupiah"
        },
        "category": {
          "type": "string",
          "maxLength": 80,
          "description": "Kategori transaksi"
        },
        "date": {
          "type": "string",
          "maxLength": 35,
          "description": "Tanggal transaksi format YYYY-MM-DD"
        },
        "description": {
          "type": "string",
          "maxLength": 250,
          "description": "Deskripsi atau keterangan transaksi"
        },
        "paymentMethod": {
          "type": "string",
          "enum": [
            "cash",
            "bank_transfer",
            "qris",
            "ewallet",
            "receivable_payable",
            "other"
          ],
          "description": "Metode pembayaran"
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "Catatan tambahan"
        },
        "receiptUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "URL atau data bukti nota"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50,
          "description": "Timestamp pembuatan"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50,
          "description": "Timestamp pembaruan"
        }
      },
      "required": [
        "id",
        "userId",
        "type",
        "amount",
        "category",
        "date"
      ]
    },
    "Category": {
      "title": "Category",
      "description": "Kategori keuangan khusus UMKM",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "ID kategori"
        },
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "ID pemilik kategori"
        },
        "name": {
          "type": "string",
          "maxLength": 60,
          "description": "Nama kategori"
        },
        "type": {
          "type": "string",
          "enum": [
            "income",
            "expense"
          ],
          "description": "Tipe kategori: income atau expense"
        },
        "color": {
          "type": "string",
          "maxLength": 30,
          "description": "Kode warna hex atau nama warna badge"
        },
        "icon": {
          "type": "string",
          "maxLength": 40,
          "description": "Nama ikon"
        },
        "isDefault": {
          "type": "boolean",
          "description": "Penanda kategori bawaan sistem"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50,
          "description": "Timestamp pembuatan"
        }
      },
      "required": [
        "id",
        "userId",
        "name",
        "type"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Profil bisnis pengguna UMKM"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Subkoleksi transaksi keuangan milik pengguna"
    },
    "/users/{userId}/categories/{categoryId}": {
      "schema": "Category",
      "description": "Subkoleksi kategori khusus pengguna"
    }
  }
}
